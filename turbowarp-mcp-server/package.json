{
  "name": "turbowarp-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for reading, editing, creating, exporting, and headlessly running TurboWarp / Scratch SB3 projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "turbowarp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "node test/smoke.mjs",
    "smoke:http": "node test/http-smoke.mjs",
    "schemas": "node scripts/dump-schemas.mjs",
    "test": "npm run build && npm run smoke && npm run smoke:http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "scratch-parser": "github:TurboWarp/scratch-parser#master",
    "scratch-storage": "^4.1.27",
    "scratch-vm": "^5.0.300",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "scratch-parser": "$scratch-parser"
  }
}
